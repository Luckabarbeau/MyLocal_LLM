{
  "version": 1,
  "family": "python",
  "purpose": "Progressive code-generation tasks with multiple deterministic unit tests in isolated sandbox.",
  "tasks": [
    {
      "id": "challenge_running_total",
      "category": "running_total",
      "difficulty": "intermediate",
      "function": "running_total",
      "prompt": "def running_total(values: list[int]) -> list[int]:\n    \"\"\"Return prefix sums, preserving order.\"\"\"\n",
      "tests": [
        {
          "args": [
            [
              1,
              2,
              3
            ]
          ],
          "expected": [
            1,
            3,
            6
          ]
        },
        {
          "args": [
            []
          ],
          "expected": []
        },
        {
          "args": [
            [
              -2,
              5,
              1
            ]
          ],
          "expected": [
            -2,
            3,
            4
          ]
        }
      ]
    },
    {
      "id": "challenge_median_odd",
      "category": "median_odd",
      "difficulty": "intermediate",
      "function": "median_odd",
      "prompt": "def median_odd(values: list[int]) -> int:\n    \"\"\"Return the median of a nonempty odd-length list without changing it.\"\"\"\n",
      "tests": [
        {
          "args": [
            [
              9,
              2,
              4
            ]
          ],
          "expected": 4
        },
        {
          "args": [
            [
              5
            ]
          ],
          "expected": 5
        },
        {
          "args": [
            [
              11,
              8,
              3,
              1,
              7
            ]
          ],
          "expected": 7
        }
      ]
    },
    {
      "id": "challenge_is_palindrome",
      "category": "is_palindrome",
      "difficulty": "basic",
      "function": "is_palindrome",
      "prompt": "def is_palindrome(text: str) -> bool:\n    \"\"\"Return whether text reads the same backwards.\"\"\"\n",
      "tests": [
        {
          "args": [
            "abba"
          ],
          "expected": true
        },
        {
          "args": [
            "abc"
          ],
          "expected": false
        },
        {
          "args": [
            ""
          ],
          "expected": true
        }
      ]
    },
    {
      "id": "challenge_balanced_parentheses",
      "category": "balanced_parentheses",
      "difficulty": "hard",
      "function": "balanced_parentheses",
      "prompt": "def balanced_parentheses(text: str) -> bool:\n    \"\"\"Check properly nested parentheses, ignoring other characters.\"\"\"\n",
      "tests": [
        {
          "args": [
            "(()())"
          ],
          "expected": true
        },
        {
          "args": [
            ")(()"
          ],
          "expected": false
        },
        {
          "args": [
            "(a)(b)"
          ],
          "expected": true
        },
        {
          "args": [
            "(()"
          ],
          "expected": false
        }
      ]
    },
