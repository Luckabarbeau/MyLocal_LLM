    {
      "id": "square",
      "function": "square",
      "prompt": "def square(x: int) -> int:\n    \"\"\"Return x squared.\"\"\"\n",
      "tests": [
        {
          "args": [
            -5
          ],
          "expected": 25
        },
        {
          "args": [
            0
          ],
          "expected": 0
