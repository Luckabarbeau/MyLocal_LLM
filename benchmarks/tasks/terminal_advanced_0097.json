    {
      "id": "terminal_advanced_show_directory",
      "category": "linux",
      "difficulty": "intermediate",
      "prompt": "# Display the current directory.\n$ ",
      "choices": [
        " pwd",
        " find . -type f -name '*.py'",
        " git remote -v",
        " ls"
      ],
      "answer": 0,
      "accepted_patterns": [
        "pwd"
      ]
    },
    {
      "id": "terminal_advanced_list_hidden",
      "category": "linux",
      "difficulty": "intermediate",
      "prompt": "# List hidden files along with other files.\n$ ",
      "choices": [
        " find . -type f -name '*.py' | wc -l",
        " ls -la",
        " git stash list",
        " ls"
      ],
      "answer": 1,
      "accepted_patterns": [
        "ls -(?:la|al|a)"
      ]
    },
    {
