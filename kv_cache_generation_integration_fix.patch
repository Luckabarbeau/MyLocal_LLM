@@ -0,0 +1,156 @@
+"""Integration tests for TextGenerator's KV-cache control flow."""
+
+import numpy as np
+
+from inference import TextGenerator
+from mini_llm.backend import xp
+
+
+class _FakeTokenizer:
+    eos_token_id = 2
+
+    def encode(self, text):
+        # Stable three-token prompt; special-token handling is irrelevant here.
+        return [7, 8, 9]
+
+    def decode(self, ids):
+        return " ".join(str(int(i)) for i in ids)
+
+
+class _FakeState:
+    def __init__(self, max_length=32):
+        self.max_length = max_length
+        self.length = 0
+        self.batch_size = 1
+        self.reset_calls = 0
+
+    def reset(self):
+        self.length = 0
+        self.reset_calls += 1
+
+    def has_capacity(self, n_tokens=1):
+        return self.length + n_tokens <= self.max_length
+
+
+class _FakeInferenceModel:
+    def __init__(self, state):
+        self.state = state
+        self.prefill_calls = []
+        self.decode_calls = []
+
+    @staticmethod
+    def _logits(next_id):
+        logits = xp.full((1, 16), -100.0, dtype=xp.float32)
+        logits[0, next_id] = 100.0
+        return logits
+
+    def prefill(self, input_ids, state):
+        self.prefill_calls.append(np.asarray(input_ids).copy())
+        state.length += int(input_ids.shape[1])
+        return self._logits(3)
+
+    def decode_one(self, token, state):
+        self.decode_calls.append(np.asarray(token).copy())
+        assert token.shape == (1, 1)
+        state.length += 1
+        # Generate 4, 5, 6 after the first token 3.
+        return self._logits(3 + len(self.decode_calls))
+
+
+class _FakeTrainingModel:
+    class _Config:
+        pass
+
+    config = _Config()
+    dtype = "float32"
+
+    def __init__(self):
+        self.forward_calls = 0
+
+    def forward(self, input_ids):
+        self.forward_calls += 1
+        B, T = input_ids.shape
+        logits = xp.full((B, T, 16), -100.0, dtype=xp.float32)
+        logits[:, -1, 3] = 100.0
+        return logits, None
+
+
+def _make_generator():
+    training_model = _FakeTrainingModel()
+    generator = TextGenerator(training_model, _FakeTokenizer(), max_context=32)
+    state = _FakeState(max_length=32)
+    inference_model = _FakeInferenceModel(state)
+    generator._inference_model = inference_model
+    generator._state = state
+    return generator, training_model, inference_model, state
+
+
+def test_kv_generation_prefills_once_then_decodes_single_tokens():
+    generator, training_model, inference_model, state = _make_generator()
+
+    text, timing = generator.generate(
+        "prompt",
+        max_new_tokens=4,
+        strategy="greedy",
+        use_kv_cache=True,
+        log_speed=False,
+    )
+
+    assert text == "3 4 5 6"
+    assert len(inference_model.prefill_calls) == 1
+    assert inference_model.prefill_calls[0].shape == (1, 3)
+
+    # Four generated tokens require one prefill and only three decode calls:
+    # prefill -> logits for token 3
+    # decode(3) -> logits for token 4, etc.
+    assert len(inference_model.decode_calls) == 3
+    assert [int(call[0, 0]) for call in inference_model.decode_calls] == [3, 4, 5]
+    assert all(call.shape == (1, 1) for call in inference_model.decode_calls)
+
+    # The reference training model must never be called by the KV path.
+    assert training_model.forward_calls == 0
+
+    # Prompt length 3 + three tokens inserted by decode_one(). The final sampled
+    # token does not need a forward pass because generation ends immediately.
+    assert state.length == 6
+    assert state.reset_calls == 1
+
+
+def test_kv_state_is_reset_and_reused_between_generation_calls():
+    generator, _, inference_model, state = _make_generator()
+
+    generator.generate(
+        "first",
+        max_new_tokens=2,
+        strategy="greedy",
+        use_kv_cache=True,
+    )
+    first_state_identity = id(generator._state)
+
+    generator.generate(
+        "second",
+        max_new_tokens=2,
+        strategy="greedy",
+        use_kv_cache=True,
+    )
+
+    assert id(generator._state) == first_state_identity
+    assert state.reset_calls == 2
+    assert len(inference_model.prefill_calls) == 2
+    assert state.length == 4  # 3 prompt tokens + one decode insertion
+
+
+def test_reference_backend_still_uses_full_prefix_model_forward():
+    generator, training_model, inference_model, _ = _make_generator()
+
+    text, _ = generator.generate(
+        "prompt",
+        max_new_tokens=3,
+        strategy="greedy",
+        use_kv_cache=False,
+    )
+
+    assert text == "3 3 3"
+    assert training_model.forward_calls == 3
+    assert len(inference_model.prefill_calls) == 0
+    assert len(inference_model.decode_calls) == 0
