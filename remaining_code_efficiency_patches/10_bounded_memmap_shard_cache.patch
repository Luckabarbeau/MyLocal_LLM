+def map_token_shard(shard_path: str) -> np.memmap:
+    """Memory-map a token shard without reading the full file into RAM.
+
+    Supports both the legacy rectangular format (16-byte header containing
+    num_documents and context_length) and the current packed 1D token stream.
+    The returned object is read-only and can be passed directly to
+    ``create_minibatch``.
+    """
+    path = Path(shard_path)
+    file_size = path.stat().st_size
+
+    if file_size >= 16:
+        with open(path, "rb") as f:
+            header = f.read(16)
+
+        num_docs = int.from_bytes(header[0:8], byteorder="little")
+        context_len = int.from_bytes(header[8:16], byteorder="little")
+        expected_data_size = num_docs * context_len * np.dtype(np.uint16).itemsize
+
+        # Legacy files contain exactly a 16-byte header followed by the token
+        # matrix.  Allow trailing bytes for compatibility with older writers,
+        # but only accept plausible positive dimensions.
+        if (
+            num_docs > 0
+            and context_len > 0
+            and expected_data_size <= file_size - 16
+        ):
+            return np.memmap(
+                path,
+                dtype=np.uint16,
+                mode="r",
+                offset=16,
+                shape=(num_docs, context_len),
+            )
+
+    # Current packed format: the complete file is a contiguous uint16 stream.
+    return np.memmap(path, dtype=np.uint16, mode="r")
+
+
