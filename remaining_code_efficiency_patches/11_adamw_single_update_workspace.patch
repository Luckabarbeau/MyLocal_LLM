+                m_cpu = self.m[i].get() if hasattr(self.m[i], "get") else self.m[i]
+                v_cpu = self.v[i].get() if hasattr(self.v[i], "get") else self.v[i]
                 if not (np.all(np.isfinite(m_cpu)) and np.all(np.isfinite(v_cpu))):
                     raise FloatingPointError(
