+            update = xp.sqrt(self.v[i])
+            update += eps_scaled
+            xp.divide(self.m[i], update, out=update)
+            update *= step_size
+
             if p.decay and self.weight_decay != 0.0:
                 self.master_weights[i] *= (1.0 - eta * self.weight_decay)
-            
-            # Adam update on master weights
